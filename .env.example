# An OpenAI-compatible Chat Completions endpoint.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-5.4-mini
MODEL_API_KEY=
# Alternatively use your own local llama.cpp server (no key needed):
# MODEL_BASE_URL=http://127.0.0.1:8081/v1
# MODEL_NAME=home-chat
# MODEL_API_KEY=
# OPENAI_API_KEY and OPENAI_BASE_URL are supported as fallbacks.
MODEL_MAX_OUTPUT_TOKENS=3000
# Optional: Mozaik Cloud observability project key. Pair with its official CLI.
# MOZAIK_API_KEY=
PORT=4317
HOST=127.0.0.1
RUN_TIMEOUT_MS=600000
